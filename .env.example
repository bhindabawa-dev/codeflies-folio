# Neon / Prisma PostgreSQL Database Connection String
# Example Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/folio_db?schema=public"

# NextAuth / Auth.js Configuration
AUTH_SECRET="folio_super_secret_session_jwt_key_32chars_min_length_2026"
NEXTAUTH_SECRET="folio_super_secret_session_jwt_key_32chars_min_length_2026"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (From Google Cloud Console: APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Default Admin Seed Account
ADMIN_DEFAULT_EMAIL="admin@codeflies.com"
ADMIN_DEFAULT_PASSWORD="admin123"
